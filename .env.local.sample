# Local development secrets. Copy to .env.local.
# Not loaded when NODE_ENV=test, so see .env.test for the test equivalents.

### Backend API
BONUSCALC_SERVICE_API_URL=
BONUSCALC_SERVICE_API_KEY=

### Auth (NextAuth + Cognito)
NEXTAUTH_URL=
NEXTAUTH_SECRET=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
# Optional. Leave unset for a public (PKCE only) app client
COGNITO_CLIENT_SECRET=
