# Unit and Cypress e2e tests. Copy to .env.test.
# Overrides .env, so only values that differ or are test-only belong here.
# .env.local is not loaded in test mode, so secrets are repeated here.

### Backend API
BONUSCALC_SERVICE_API_URL=
BONUSCALC_SERVICE_API_KEY=

### Notify
NOTIFY_API_KEY=

### Auth
# Use http for e2e, as https changes the session cookie name
NEXTAUTH_URL=
NEXTAUTH_SECRET=

### Cypress real Cognito flow
COGNITO_E2E_ISSUER=
COGNITO_E2E_CLIENT_ID=
COGNITO_E2E_USERNAME=
COGNITO_E2E_PASSWORD=
