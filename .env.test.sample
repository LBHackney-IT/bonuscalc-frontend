# Unit and Cypress e2e tests. Copy to .env.test.
# Overrides .env, so only values that differ or are test-only belong here.
# .env.local is not loaded in test mode, so secrets are repeated here.

### Environment
NEXT_PUBLIC_NODE_ENV=test

### Backend API
BONUSCALC_SERVICE_API_URL=http://localhost:5101/api
BONUSCALC_SERVICE_API_KEY=dummykey

### Notify
# Not a valid key - it's generated using random uuids
NOTIFY_API_KEY=test-bd7aa1c0-5de1-013a-f4cc-2cde48001122-c1f41b30-5de1-013a-f4cd-2cde48001122

### Auth
# Use http for e2e, as https changes the session cookie name
NEXTAUTH_URL=http://localhost:5001
NEXTAUTH_SECRET=

### Cypress real Cognito flow
COGNITO_E2E_ISSUER=
COGNITO_E2E_CLIENT_ID=
COGNITO_E2E_USERNAME=
COGNITO_E2E_PASSWORD=
