# Shared, non-secret config. Loaded in every mode (dev, test and production).
# Copy to .env. Secrets live in .env.local (dev) and .env.test (test) instead.

### Environment
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_ENV_NAME=development
TZ=Europe/London
LOG_LEVEL=DEBUG

### Roles (Google group names that map to each role)
OPERATIVE_MANAGERS_GOOGLE_GROUPNAME=repairs-hub-operative-manager
WEEK_MANAGERS_GOOGLE_GROUPNAME=bonus-scheme-week-manager
AUTHORISATION_MANAGERS_GOOGLE_GROUPNAME=bonus-scheme-authorisations-manager

### Bonus periods
NEXT_PUBLIC_FIRST_WEEK=2021-08-02

### Repairs Hub
NEXT_PUBLIC_REPAIRS_HUB_URL=https://repairs-hub.hackney.gov.uk/work-orders

### Pay elements
NEXT_PUBLIC_OVERTIME_HOURS_TYPE_ID=400
NEXT_PUBLIC_OVERTIME_JOB_TYPE_ID=401
# Also known as the Overtime Rate
NEXT_PUBLIC_OVERTIME_RATE=24.34

NEXT_PUBLIC_OOH_ROTA_TYPE_ID=500
NEXT_PUBLIC_OOH_JOB_TYPE_ID=501
# Also known as the Call Out Standby rate. It is *not* the Call Out Job rate
NEXT_PUBLIC_OOH_RATE=27.51

### Notify
NOTIFY_TEMPLATE_ID=40934a7a-8e8d-4d87-a29e-bb0358dc7c42
NOTIFY_BC_TEMPLATE_ID=49a1c399-6137-4cb5-98bf-b31035aa1c41

### Sentry (client and server)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DEBUG=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_DEBUG=false
