# Shared, non-secret config. Loaded in every mode (dev, test and production).
# Copy to .env. Secrets live in .env.local (dev) and .env.test (test) instead.

### Environment
NEXT_PUBLIC_NODE_ENV=
NEXT_PUBLIC_ENV_NAME=
TZ=
LOG_LEVEL=

### Roles (Google group names that map to each role)
OPERATIVE_MANAGERS_GOOGLE_GROUPNAME=
WEEK_MANAGERS_GOOGLE_GROUPNAME=
AUTHORISATION_MANAGERS_GOOGLE_GROUPNAME=

### Bonus periods
NEXT_PUBLIC_FIRST_WEEK=

### Repairs Hub
NEXT_PUBLIC_REPAIRS_HUB_URL=

### Pay elements
NEXT_PUBLIC_OVERTIME_HOURS_TYPE_ID=
NEXT_PUBLIC_OVERTIME_JOB_TYPE_ID=
# Also known as the Overtime Rate
NEXT_PUBLIC_OVERTIME_RATE=

NEXT_PUBLIC_OOH_ROTA_TYPE_ID=
NEXT_PUBLIC_OOH_JOB_TYPE_ID=
# Also known as the Call Out Standby rate. It is *not* the Call Out Job rate
NEXT_PUBLIC_OOH_RATE=

### Notify
NOTIFY_TEMPLATE_ID=
NOTIFY_BC_TEMPLATE_ID=

### Sentry (client and server)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DEBUG=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_DEBUG=
